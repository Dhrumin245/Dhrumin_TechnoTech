# Copy to .env for local development. NEVER commit a real .env file.

# --- Server ---
PORT=5000
# Extra origins allowed by CORS, comma-separated, EXACT origins only (no wildcards).
# https://www.dhrumintechnotech.in, https://dhrumintechnotech.in and localhost are always allowed.
# Add e.g. your Vercel project URL or one specific preview URL here if the site is served from it.
ALLOWED_ORIGINS=

# --- Database ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# --- Email (Resend is tried first, SMTP is the fallback) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_FROM=
EMAIL_TO=you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
